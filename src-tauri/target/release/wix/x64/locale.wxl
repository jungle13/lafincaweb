<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch ELIANA POS</String><String Id="DowngradeErrorMessage">A newer version of ELIANA POS is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the ELIANA POS executable to the PATH system environment variable. This allows the ELIANA POS executable to be called from any location.</String><String Id="InstallAppFeature">Installs ELIANA POS.</String></WixLocalization>