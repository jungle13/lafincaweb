{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "La Finca POS",
  "version": "1.0.0",
  "identifier": "com.lafinca.pos",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:3000/pos"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "La Finca — Punto de Venta",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
